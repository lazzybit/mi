{
  "name": "mi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first durable web app (Cloudflare Workers + Solid 2)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "npm run build && vitest run --project workers",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@solidjs/router": "2.0.0-next.38",
    "@solidjs/web": "2.0.0-rc.15",
    "jose": "6.2.12",
    "solid-js": "2.0.0-rc.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.2",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@playwright/test": "1.64.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "24.10.1",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
