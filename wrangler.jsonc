{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mi.nomonator.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OWNER",
        "class_name": "OwnerObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OwnerObject"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACCESS_ISSUER": "https://nomonator.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "3432b3f861ecf6603e5a5493cae17f8a5b6631b2ceb4d01dded8e81855a0edb4",
    "OAUTH_CLIENT_METADATA_URL": "https://mi.nomonator.com/oauth/client-metadata.json"
  }
}
