{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mi.nomonator.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION",
        "class_name": "SessionObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OwnerObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionObject"],
      "deleted_classes": ["OwnerObject"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mi",
      "database_id": "325930a8-ff96-403b-8f62-00302d6e7fcc"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACCESS_ISSUER": "https://nomonator.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "3432b3f861ecf6603e5a5493cae17f8a5b6631b2ceb4d01dded8e81855a0edb4"
  }
}
